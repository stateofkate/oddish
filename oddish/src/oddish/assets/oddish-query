#!/usr/bin/env node
'use strict';

const LOG_HEAD = 4000, LOG_TAIL = 4000;
const BASE = (process.env.ODDISH_API_BASE_URL || '').replace(/\/+$/, '');
const KEY = process.env.ODDISH_API_KEY || '';

const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');

function out(line) { process.stdout.write(line + '\n'); }
function die(msg, status) { out(JSON.stringify({ error: msg, status })); process.exit(1); }

async function get(path, params) {
  const url = new URL((BASE || 'http://fixture') + path);
  for (const [k, v] of Object.entries(params || {})) {
    if (v !== null && v !== undefined && v !== '') url.searchParams.set(k, v);
  }
  const fixture = process.env.ODDISH_QUERY_TEST_FIXTURE;
  if (fixture) {
    const f = JSON.parse(fixture);
    if (f.__status === 401) die('session credential expired', 401);
    const fixturePath = url.pathname + url.search;
    return Object.hasOwn(f, fixturePath) ? f[fixturePath] : f[path];
  }
  let r;
  try { r = await fetch(url, { headers: { Authorization: `Bearer ${KEY}` } }); }
  catch (e) { die(String(e), 0); }
  if (r.status === 401) die('session credential expired', 401);
  if (!r.ok) die(r.statusText || `HTTP ${r.status}`, r.status);
  return r.json();
}

async function cmdLogs(a) {
  const data = await get(`/trials/${a.trialId}/logs`);
  let text = typeof data === 'string' ? data : JSON.stringify(data);
  if (text.length > LOG_HEAD + LOG_TAIL) {
    text = text.slice(0, LOG_HEAD) + '\n…[truncated]…\n' + text.slice(-LOG_TAIL);
  }
  out(text);
}

async function cmdTrialResource(a) {
  const value = await get(`/trials/${a.trialId}/${a.resource}`);
  out(JSON.stringify({ trial_id: a.trialId, [a.outputKey || a.resource]: value }));
}

async function cmdTrialVerifier(a) {
  const data = await get(`/trials/${a.trialId}/logs/structured?verifier_only=true`);
  out(JSON.stringify({
    trial_id: a.trialId,
    verifier: data?.verifier || { stdout: null, stderr: null },
    exception: data?.exception ?? null,
  }));
}

function taskId() {
  const id = process.env.ODDISH_PROBE_TASK_ID || '';
  if (!id) die('missing task id: ODDISH_PROBE_TASK_ID not set', 2);
  return id;
}

function taskFileParams(params) {
  return { ...(params || {}), version: process.env.ODDISH_PROBE_TASK_VERSION || '' };
}

async function fetchFileContent(relPath) {
  const data = await get(`/tasks/${taskId()}/files/${relPath}`, taskFileParams());
  if (data == null || typeof data.content !== 'string') die(`no such file: ${relPath}`, 4);
  return data.content;
}

async function listFiles(prefix) {
  const data = await get(`/tasks/${taskId()}/files`, taskFileParams({ prefix, recursive: true, presign: true }));
  return (data && data.files) || [];
}

async function fetchUrlBytes(url) {
  let r;
  try { r = await fetch(url); } catch (e) { die(String(e), 0); }
  if (!r.ok) die(r.statusText || `HTTP ${r.status}`, r.status);
  return Buffer.from(await r.arrayBuffer());
}

// Download every file under `prefix` into destDir, preserving the path tail
// after `prefix`. Uses presigned `url` when present, else inline `content`
// (test fixture), else a per-file content GET.
async function materializeFiles(prefix, destDir) {
  const files = await listFiles(prefix);
  let n = 0;
  for (const f of files) {
    if (prefix && !f.path.startsWith(prefix)) continue;
    const rel = prefix ? f.path.slice(prefix.length).replace(/^\/+/, '') : f.path;
    const dest = path.join(destDir, rel);
    fs.mkdirSync(path.dirname(dest), { recursive: true });
    let body;
    if (f.url) body = await fetchUrlBytes(f.url);
    else if (typeof f.content === 'string') body = f.content;
    else body = await fetchFileContent(f.path);
    const actualSize = Buffer.isBuffer(body) ? body.length : Buffer.byteLength(body);
    if (Number.isInteger(f.size) && actualSize !== f.size) {
      die(`task file size mismatch: ${f.path} (expected ${f.size}, got ${actualSize})`, 5);
    }
    fs.writeFileSync(dest, body);
    n += 1;
  }
  return { count: n, files };
}

async function cmdTaskCat(a) {
  const rel = (a.rel || '').replace(/^\/+/, '');
  out(await fetchFileContent(rel));
}

async function cmdTaskFetch(a) {
  const dest = a.into || fs.mkdtempSync(path.join(os.tmpdir(), 'probe-task-'));
  const { count } = await materializeFiles('', dest);
  if (!count) die('probe asset unavailable: task', 3);
  out(`copied task (${count} files) to ${dest}`);
}

const HELP = `oddish-query — bounded read access to task and trial evidence

USAGE: node /probe-harness/oddish-query <group> <command> [args]

  task cat <path>             print one task source file
  task fetch [--into DIR]     copy the whole task source tree into DIR
  trials result <trial_id>     complete Harbor result.json for one trial
  trials trajectory <trial_id>
                              complete ATIF trajectory for one trial
  trials verifier <trial_id>  complete verifier stdout/stderr and exception
  trials logs <trial_id>       trial logs (large logs may be truncated)`;

function parse(argv) {
  const pos = [], opt = {};
  for (let i = 0; i < argv.length; i++) {
    const t = argv[i];
    if (t.startsWith('--')) {
      const k = t.slice(2);
      if (k === 'trajectory' || k === 'tail-bytes') die(`unknown option: --${k}`, 2);
      if (k === 'help') opt.help = true;
      else opt[k] = argv[++i];
    } else pos.push(t);
  }
  return { pos, opt };
}

async function main() {
  const { pos, opt } = parse(process.argv.slice(2));
  const [group, cmd, id] = pos;
  if (!group || group === '--help' || group === '-h' || opt.help) { out(HELP); return; }
  if (cmd === '--help' || cmd === '-h') { out(HELP); return; }
  const a = { rel: id, trialId: id, resource: cmd };
  if (group === 'trials' && (cmd === 'result' || cmd === 'trajectory')) return cmdTrialResource(a);
  if (group === 'trials' && cmd === 'verifier') return cmdTrialVerifier(a);
  if (group === 'trials' && cmd === 'logs') return cmdLogs(a);
  if (group === 'task' && cmd === 'cat') return cmdTaskCat(a);
  if (group === 'task' && cmd === 'fetch') return await cmdTaskFetch({ into: opt.into });
  die(`unknown command: ${group} ${cmd}`, 2);
}
main();
